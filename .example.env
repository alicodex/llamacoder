# Required
TOGETHER_API_KEY=
DATABASE_URL=                      # Supabase pooled connection string (port 6543)
NEXT_PUBLIC_SUPABASE_URL=          # Supabase project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # Supabase anon/public key
SITE_URL=                          # Your deployed URL (e.g. https://llamacoder.pages.dev)

# Admin dashboard (visit /admin to manage prompts, models, API keys, etc.)
ADMIN_PASSWORD=             # Password for admin login
ADMIN_SESSION_SECRET=       # Random string for cookie validation (generate with: openssl rand -hex 32)

# Optional
CSB_API_KEY=
HELICONE_API_KEY=